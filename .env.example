# nexus-edge environment — copy to .env and adjust before first start.

# Host port published by nexus-core (FastAPI + static frontend)
NEXUS_CORE_PORT=8000

# Single admin password for the review workbench / gateway dashboard
NEXUS_ADMIN_PASSWORD=change-me-before-use

# nexus-db credentials. These names are fixed by the official postgres image
# contract (only read during first cluster initialization); change the values
# before any real deployment.
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus-dev-only-change-me
POSTGRES_DB=nexus

# Timezone for the containers
TZ=Asia/Shanghai

# Host directory for persistent data (pgdata/, media/, sessions/).
# Relative paths resolve against the compose project directory.
NEXUS_DATA_DIR=./data

# nexus-bridge: seconds between database connection checks
NEXUS_BRIDGE_CHECK_INTERVAL=30

# nexus-bridge: protocol credentials from the platform app portal.
# Leave empty to keep the real-protocol path idle.
NEXUS_BRIDGE_API_ID=
NEXUS_BRIDGE_API_HASH=

# 1 = feed synthetic albums through the debounce pipeline (no external
# network); used to verify album aggregation end to end
NEXUS_BRIDGE_SIM=0
NEXUS_BRIDGE_SIM_INTERVAL=15

# M5 AI rule generation (OpenAI-compatible endpoint). Leave empty to
# keep the AI entry disabled; rules editor + dry-run always work.
NEXUS_LLM_BASE_URL=
NEXUS_LLM_API_KEY=
NEXUS_LLM_MODEL=
# set to 1 only if the LLM endpoint lives on your LAN (private address)
NEXUS_LLM_ALLOW_PRIVATE_HOSTS=0
